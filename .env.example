# LOCAL ONLY - gitignored. Never commit.
# Local 3-node Docker cluster (development + chaos demo)
LOCAL_DATABASE_URL=postgresql://root@localhost:26257/recall?sslmode=disable

# CockroachDB Cloud - the SQL connection the app stores memories in.
CRDB_CLUSTER_ID=
CRDB_SQL_USER=
CRDB_SQL_PASSWORD=
CRDB_HOST=
CLOUD_DATABASE_URL=

# CockroachDB Cloud's managed MCP server (https://cockroachlabs.cloud/mcp),
# which Orbis connects OUT to as an MCP client. Optional: without it, the Cloud
# MCP panel in Signals reports itself unconfigured and the chat agent simply
# never sees the crdb_* tools.
#
# Cloud Console -> Access Management -> Service Accounts: create one with the
# Cluster Operator role, then create an API key and paste the secret here. OAuth
# is the other supported method and needs a browser, so it cannot be used by a
# server process. CRDB_CLUSTER_ID above doubles as the mcp-cluster-id header,
# which pins the connection to one cluster.
CRDB_CLOUD_API_KEY=

# Which one the app uses: "local" or "cloud"
RECALL_TARGET=local

# AWS
AWS_REGION=ap-south-1
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Claude in ap-south-1 is INFERENCE_PROFILE-only: the bare anthropic.* id is
# rejected, the apac.* inference-profile id is required.
BEDROCK_CHAT_MODEL=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
