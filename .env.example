# LOCAL ONLY - gitignored. Never commit.
# Local 3-node Docker cluster (development + chaos demo)
LOCAL_DATABASE_URL=postgresql://root@localhost:26257/recall?sslmode=disable

# CockroachDB Cloud (Managed MCP Server + hosted demo)
CRDB_CLUSTER_ID=
CRDB_SQL_USER=
CRDB_SQL_PASSWORD=
# TODO: paste the host from the Cloud console Connect modal, e.g.
#   recall-1234.j77.aws-ap-south-1.cockroachlabs.cloud
CRDB_HOST=
CLOUD_DATABASE_URL=

# Which one the app uses: "local" or "cloud"
RECALL_TARGET=local

# AWS
AWS_REGION=us-east-1
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
