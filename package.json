{
  "name": "recall",
  "version": "0.1.0",
  "private": true,
  "description": "Governable agent memory: typed beliefs, atomic decision lineage, and blast-radius recall on CockroachDB.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:migrate": "node scripts/migrate.mjs",
    "db:sql": "docker compose exec roach1 cockroach sql --insecure --database=recall",
    "chaos:kill": "docker kill recall-roach2-1",
    "chaos:heal": "docker start recall-roach2-1",
    "test": "node --test \"tests/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/*.test.ts\"",
    "api": "node services/api/server.ts",
    "seed": "node scripts/seed.ts --target=local --reset",
    "dev": "npm run dev --prefix apps/console",
    "build": "npm run build --prefix apps/console"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10"
  },
  "type": "module"
}
